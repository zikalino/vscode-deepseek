{
  "name": "vscode-deepseek-obsidian",
  "version": "0.0.49",
  "description": "DeepSeek-powered coding assistant for VS Code with Copilot integration and an autonomous Zero panel.",
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/zikalino/vscode-deepseek.git"
  },
  "icon": "imgs/logo.png",
  "type": "commonjs",
  "main": "./out/extension.js",
  "scripts": {
    "prepare:shared-components": "node ./scripts/materialize-shared-components.js",
    "precompile": "npm run prepare:shared-components",
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node --test \"server/*.test.mjs\" \"test/*.test.cjs\"",
    "lint": "echo \"No lint configured\""
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "displayName": "SmarterCode DeepSeek",
  "publisher": "Zim",
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguageModelChatProvider:deepseek",
    "onCommand:deepseek.showLogs",
    "onCommand:deepseek.showUsageGraph",
    "onCommand:deepseek.advance.newChat",
    "onCommand:deepseek.advance.abort",
    "onCommand:deepseek.advance.runWorkflow",
    "onCommand:deepseek.advance.showWorkflow",
    "onCommand:deepseek.advance.openWorkflowDocument",
    "onCommand:deepseek.advance.githubSignIn",
    "onCommand:deepseek.advance.githubSignOut",
    "onCommand:deepseek.advance.openSettings"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "deepseek",
        "displayName": "DeepSeek",
        "icon": "imgs/logo.png",
        "configuration": {
          "title": "DeepSeek",
          "properties": {
            "apiKey": {
              "type": "string",
              "markdownDescription": "DeepSeek API key used by the DeepSeek models in VS Code Chat. Stored in VS Code secret storage for this provider.",
              "secret": true
            }
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deepseek-advance",
          "title": "Zero",
          "icon": "$(circle-slash)"
        }
      ]
    },
    "views": {
      "deepseek-advance": [
        {
          "id": "deepseek.advanceView",
          "name": "Zero",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "deepseek.setApiKey",
        "title": "DeepSeek: Set API Key",
        "icon": "$(key)"
      },
      {
        "command": "deepseek.clearApiKey",
        "title": "DeepSeek: Clear API Key"
      },
      {
        "command": "deepseek.showLogs",
        "title": "DeepSeek: Browse Failed Requests"
      },
      {
        "command": "deepseek.showUsageGraph",
        "title": "DeepSeek: Show Token Usage Graph",
        "icon": "$(graph)"
      },
      {
        "command": "deepseek.account.signIn",
        "title": "Sign In for Free Tokens",
        "category": "DeepSeek"
      },
      {
        "command": "deepseek.account.showUsage",
        "title": "Show Token Allowance",
        "category": "DeepSeek"
      },
      {
        "command": "deepseek.account.signOut",
        "title": "Sign Out of Token Allowance",
        "category": "DeepSeek"
      },
      {
        "command": "deepseek.useAsDefaultModel",
        "title": "Use as Default Chat Model",
        "category": "DeepSeek"
      },
      {
        "command": "deepseek.advance.newChat",
        "title": "New Zero Chat",
        "category": "DeepSeek",
        "icon": "$(add)"
      },
      {
        "command": "deepseek.advance.abort",
        "title": "Stop the Zero Turn",
        "category": "DeepSeek",
        "icon": "$(debug-stop)"
      },
      {
        "command": "deepseek.advance.runWorkflow",
        "title": "Run Workflow...",
        "category": "DeepSeek",
        "icon": "$(play)"
      },
      {
        "command": "deepseek.advance.showWorkflow",
        "title": "Show Workflow...",
        "category": "DeepSeek",
        "icon": "$(preview)"
      },
      {
        "command": "deepseek.advance.openWorkflowDocument",
        "title": "Open Workflow Document...",
        "category": "DeepSeek",
        "icon": "$(go-to-file)"
      },
      {
        "command": "deepseek.advance.githubSignIn",
        "title": "Sign In to GitHub",
        "category": "DeepSeek",
        "icon": "$(github)"
      },
      {
        "command": "deepseek.advance.githubSignOut",
        "title": "Sign Out of GitHub",
        "category": "DeepSeek"
      },
      {
        "command": "deepseek.advance.openSettings",
        "title": "Configure Zero",
        "category": "DeepSeek",
        "icon": "$(gear)"
      }
    ],
    "configuration": {
      "title": "SmarterCode DeepSeek",
      "properties": {
        "deepseek.apiKey": {
          "type": "string",
          "default": "",
          "description": "DeepSeek API key (required in API mode). Prefer the DEEPSEEK_API_KEY environment variable."
        },
        "deepseek.apiEndpoint": {
          "type": "string",
          "default": "https://api.deepseek.com/chat/completions",
          "description": "DeepSeek API endpoint override."
        },
        "deepseek.model": {
          "type": "string",
          "default": "deepseek-v4-flash",
          "description": "DeepSeek model name (e.g. deepseek-v4-pro, deepseek-v4-flash)."
        },
        "deepseek.account.githubClientId": {
          "type": "string",
          "default": "",
          "markdownDescription": "Client ID of a GitHub OAuth app used for device-flow sign-in. Create one under **Settings → Developer settings → OAuth Apps**, enable **Device Flow**, then paste the client ID here. Signing in requests only `read:user` and unlocks the hosted token allowance."
        },
        "deepseek.account.proxyUrl": {
          "type": "string",
          "default": "http://localhost:8787",
          "description": "Base URL of the token-allowance proxy. It must serve POST /v1/session, GET /v1/usage and POST /v1/chat/completions (see server/)."
        },
        "deepseek-copilot.debugMode": {
          "type": "string",
          "enum": [
            "minimal",
            "metadata",
            "verbose"
          ],
          "default": "minimal",
          "description": "Controls Copilot request diagnostics. Minimal hides request summaries; metadata and verbose log request summaries and token usage to the DeepSeek output channel."
        },
        "deepseek-copilot.stabilizePromptCache": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Replace the per-session identifiers VS Code puts in the system prompt (`<session_context>` folder and the `VSCODE_TARGET_SESSION_LOG` path) with a stable placeholder. DeepSeek caches an exact prompt prefix, so a new session UUID invalidates every token after it — including all tool definitions. Disable to send the prompt unchanged."
        },
        "deepseek.advance.harnessWasm": {
          "type": "string",
          "default": "",
          "description": "Path to advance_harness.wasm. Empty uses the copy bundled with the extension, then a workspace target/wasm32-unknown-unknown/{release,debug} build."
        },
        "deepseek.advance.galleryUrl": {
          "type": "string",
          "default": "https://github.com/zikalino/zero-gallery.git",
          "description": "Git URL of the Zero tool gallery, cloned into global storage. Change it to publish to a fork."
        },
        "deepseek.advance.allowWrite": {
          "type": "boolean",
          "default": true,
          "description": "Let the Zero agent create, edit, move and delete files in the first workspace folder."
        },
        "deepseek.advance.allowedCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Programs the Zero agent may run. Empty removes the shell tool entirely."
        },
        "deepseek.advance.commandTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 1,
          "maximum": 3600,
          "description": "How long a Zero command may run before it is killed."
        },
        "deepseek.advance.pricing.models": {
          "type": "object",
          "default": {},
          "description": "Off-peak prices in dollars per million tokens, keyed by model id, for example { \"deepseek-v4-pro\": { \"inputPerMillion\": 0.66 } }. Models left out use the built-in DeepSeek prices."
        },
        "deepseek.advance.pricing.peakMultiplier": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "description": "Multiple of the off-peak prices charged in peak hours (01:00-04:00 and 06:00-10:00 UTC, Monday-Friday). Set to 1 to bill every hour at the off-peak rate."
        },
        "deepseek.advance.pricing.holidays": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "UTC dates (YYYY-MM-DD) billed at the off-peak rate all day, such as Chinese public holidays."
        },
        "deepseek.advance.pricing.inputPerMillion": {
          "type": "number",
          "default": 0,
          "description": "Flat dollars per million uncached input tokens for every model. Non-zero replaces the built-in per-model table. Zero uses the table."
        },
        "deepseek.advance.pricing.cachedPerMillion": {
          "type": "number",
          "default": 0,
          "description": "Flat dollars per million cache-hit input tokens for every model. Non-zero replaces the built-in per-model table."
        },
        "deepseek.advance.pricing.outputPerMillion": {
          "type": "number",
          "default": 0,
          "description": "Flat dollars per million output tokens for every model. Non-zero replaces the built-in per-model table."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "deepseek.advance.newChat",
          "when": "view == deepseek.advanceView",
          "group": "navigation@1"
        },
        {
          "command": "deepseek.advance.githubSignIn",
          "when": "view == deepseek.advanceView",
          "group": "navigation@2"
        },
        {
          "command": "deepseek.setApiKey",
          "when": "view == deepseek.advanceView",
          "group": "navigation@3"
        },
        {
          "command": "deepseek.advance.openWorkflowDocument",
          "when": "view == deepseek.advanceView",
          "group": "navigation@4"
        },
        {
          "command": "deepseek.showUsageGraph",
          "when": "view == deepseek.advanceView",
          "group": "navigation@5"
        }
      ],
      "commandPalette": [
        {
          "command": "deepseek.setApiKey"
        },
        {
          "command": "deepseek.clearApiKey"
        },
        {
          "command": "deepseek.account.signIn"
        },
        {
          "command": "deepseek.account.showUsage"
        },
        {
          "command": "deepseek.account.signOut"
        },
        {
          "command": "deepseek.useAsDefaultModel"
        },
        {
          "command": "deepseek.advance.newChat"
        },
        {
          "command": "deepseek.advance.abort"
        },
        {
          "command": "deepseek.advance.runWorkflow"
        },
        {
          "command": "deepseek.advance.showWorkflow"
        },
        {
          "command": "deepseek.advance.openWorkflowDocument"
        },
        {
          "command": "deepseek.advance.githubSignIn"
        },
        {
          "command": "deepseek.advance.githubSignOut"
        },
        {
          "command": "deepseek.advance.openSettings"
        },
        {
          "command": "deepseek.showUsageGraph"
        }
      ]
    }
  }
}
